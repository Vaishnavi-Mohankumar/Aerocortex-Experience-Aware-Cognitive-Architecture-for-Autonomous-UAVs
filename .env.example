# AeroCortex Environment Configuration Template

# System
OFFLINE_MODE=true
DEVICE_TARGET=edge_uav

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
LLM_TIMEOUT_SECONDS=5.0

# Knowledge Graph (Neo4j)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aerocortex_password

# API & Dashboard
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
